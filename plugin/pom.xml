<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>kom</groupId>
    <artifactId>KnightsOfMinecraft</artifactId>
    <version>1.0</version>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>enginehub</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
    </repositories>

    <dependencies>

        <!-- Spigot -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>vault</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Vault.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>vault</artifactId>
            <version>1.7.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Vault-1.7.1.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>worldedit</artifactId>
            <version>6.1.9</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/worldedit-bukkit-6.1.9.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>worldguard</artifactId>
            <version>6.2.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/worldguard-bukkit-6.2.2.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>MythicMobs</artifactId>
            <version>4.4.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/MythicMobs-4.4.1.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>PermissionEx</artifactId>
            <version>1.23.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/PermissionsEx-1.23.4.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>PlayEffect</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/PlayEffect.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>SimpleClans</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/SimpleClans.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>mcMMO</artifactId>
            <version>1.5.00</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/mcMMO.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>heroes</artifactId>
            <version>1.5.5</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/Heroes.jar</systemPath>
        </dependency>
        
        <dependency>
            <groupId>local</groupId>
            <artifactId>simplyvanish</artifactId>
            <version>1.2.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/simplyvanish.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>bannermaker</artifactId>
            <version>1.9.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/BannerMaker.jar</systemPath>
        </dependency>

        <dependency>
            <groupId>local</groupId>
            <artifactId>citizensnpcs</artifactId>
            <version>2.0.22
            </version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/citizens-2.0.22-SNAPSHOT.jar</systemPath>
        </dependency> 

    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>

            </plugin>
        </plugins>

    </build>

</project>
